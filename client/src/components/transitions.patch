+/* Section transitions: each marked section slides up over the one before it as a
+   rounded sheet. The hero stays pinned underneath until it is covered. */
+.lh-hero {
+  position: sticky;
+  top: 0;
+  z-index: 1;
+  margin-bottom: 0;
+}
+.sheet-over {
+  position: relative;
+  z-index: 2;
+  border-radius: clamp(40px, 5vw, 60px) clamp(40px, 5vw, 60px) 0 0;
+  box-shadow: 0 -24px 60px rgba(10, 5, 16, .45);
+}
+.sheet-over--collab {
+  margin-top: calc(-1 * clamp(40px, 4vw, 56px));
+  z-index: 4;
+}
+@media (prefers-reduced-motion: reduce) {
+  .lh-hero { position: relative; }
+}
